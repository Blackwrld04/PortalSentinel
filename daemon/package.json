{
  "name": "portal-sentinel-daemon",
  "version": "1.0.0",
  "description": "Autonomous threat detection & closed-loop defense dispatcher for Portaldot V3",
  "main": "src/index.ts",
  "bin": {
    "sentinel": "src/cli.ts"
  },
  "scripts": {
    "start": "NODE_OPTIONS=\"--dns-result-order=ipv4first --no-network-family-autoselection\" tsx src/index.ts",
    "simulate": "NODE_OPTIONS=\"--dns-result-order=ipv4first --no-network-family-autoselection\" tsx src/simulateAttack.ts",
    "cli": "NODE_OPTIONS=\"--dns-result-order=ipv4first --no-network-family-autoselection\" tsx src/cli.ts",
    "build": "tsc",
    "test": "node --import tsx --test src/*.test.ts",
    "telegram:bot": "NODE_OPTIONS=\"--dns-result-order=ipv4first --no-network-family-autoselection\" tsx src/telegramBot.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "ethers": "^6.13.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}