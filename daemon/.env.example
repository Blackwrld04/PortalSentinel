# ==============================================================================
# PortalSentinel Daemon Environment Configuration
# Copy to daemon/.env and fill in only what you need. Never commit .env.
# ==============================================================================

# Portaldot V3 EVM RPC endpoint
PORTALDOT_RPC_URL=https://test-evm-rpc-v3.portaldot.dev
# Optional comma-separated failover list (P2 will rotate across these)
# PORTALDOT_RPC_URLS=https://rpc-a.example,https://rpc-b.example
PORTALDOT_CHAIN_ID=420420777
PORTALDOT_BLOCK_TIME_MS=1000
PORTALDOT_REQUEST_TIMEOUT_MS=10000
# Blocks per getLogs batch when catching up after downtime
PORTALDOT_LOG_RANGE_BLOCKS=500
PORTALDOT_EXPLORER_URL=https://node-console.portaldot.dev/

# Deployed contract addresses on Portaldot Testnet
SENTINEL_REGISTRY_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
DEFENSE_EXECUTOR_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512
MOCK_TOKEN_ADDRESS=0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0
MOCK_EXPLOIT_ADDRESS=0xCf7Ed3AccA5a467e9e704C703E8D87F634fB0Fc9

# Guardian operator key. Required only when DRY_RUN=false.
# Generate a dedicated hot-wallet key; never reuse a personal key.
GUARDIAN_PRIVATE_KEY=
# Safe default: no transaction is broadcast until you set this to false.
DRY_RUN=true
DEFENSE_MAX_ATTEMPTS=3
DEFENSE_RECEIPT_TIMEOUT_MS=60000
# Last processed block journal (relative to the daemon working directory)
STATE_FILE=.sentinel-state.json

# Telegram 24/7 autopilot alerts
# 1. Create a bot with @BotFather on Telegram and paste the token below
TELEGRAM_BOT_TOKEN=
# 2. Get your numeric ID from @userinfobot on Telegram and paste below
TELEGRAM_CHAT_ID=
# Enable / disable push notifications
TELEGRAM_ALERTS_ENABLED=true

# Observability. Bind to 127.0.0.1 unless a reverse proxy or container network
# needs to reach the metrics endpoint.
METRICS_HOST=127.0.0.1
METRICS_PORT=3001
CORS_ORIGIN=http://localhost:3002
